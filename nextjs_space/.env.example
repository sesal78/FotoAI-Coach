
# Foto Photography Coach - App Environment Variables
# See ../.env.example for full documentation

OPENAI_API_KEY=your_openai_api_key_here

# Generate with: openssl rand -hex 32
CRON_SECRET=your_cron_secret_here

SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Foto Coach
REPLY_TO_EMAIL=support@yourdomain.com

# Weather: Open-Meteo, no API key needed (OPENWEATHERMAP_API_KEY is no longer used)

USER_EMAIL=admin@yourdomain.com

# --- FotoAI Supabase (the app's database, auth and storage) ---
# Supabase API gateway (Kong) base URL of the shared self-hosted stack
FOTOAI_SUPABASE_URL=
# Public anon key (sent with the user's own session token; RLS applies)
FOTOAI_SUPABASE_ANON_KEY=
# Service role key - server only. Used for signed URLs, deletes, XP awards.
FOTOAI_SUPABASE_SERVICE_ROLE_KEY=
# Set "true" behind HTTPS (defaults to true when NODE_ENV=production)
FOTOAI_COOKIE_SECURE=
