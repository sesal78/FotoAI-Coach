
# Database Configuration (for self-hosted Docker setup)
POSTGRES_USER=foto
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=foto
DATABASE_URL=postgresql://foto:changeme_strong_password@postgres:5432/foto

# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here_change_me

# Abacus.AI LLM API
ABACUSAI_API_KEY=your_abacusai_api_key_here

# SendGrid Email
SENDGRID_API_KEY=your_sendgrid_api_key_here
