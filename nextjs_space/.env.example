FROM_NAME=Seun - Foto Coach             # Friendly name shown to recipients
REPLY_TO_EMAIL=seun_salami@outlook.com  # Where replies are sent

# OpenWeatherMap
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# User Configuration
USER_EMAIL=seun_salami@outlook.com      # Your email for receiving notifications
