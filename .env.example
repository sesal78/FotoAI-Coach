
# ============================================================
# Foto Photography Coach - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Appwrite (deploy Appwrite separately first) ---
# The public endpoint — same value used by both server and browser
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://appwrite.yourdomain.com/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=<your-project-id>

# Server-side only (never exposed to browser)
APPWRITE_ENDPOINT=https://appwrite.yourdomain.com/v1
APPWRITE_PROJECT_ID=<your-project-id>
# API key with: databases.read/write, storage.read/write, users.read/write
APPWRITE_API_KEY=<your-server-api-key>

# Created when you run: yarn ts-node scripts/appwrite-setup.ts
APPWRITE_DATABASE_ID=<your-database-id>
APPWRITE_STORAGE_BUCKET_ID=<your-storage-bucket-id>

# --- OpenAI API (required for challenge/itinerary generation and chat) ---
OPENAI_API_KEY=your_openai_api_key_here

# --- Cron job secret (required to call /api/scheduled/* endpoints) ---
# Generate with: openssl rand -hex 32
CRON_SECRET=your_cron_secret_here

# --- SendGrid Email (required for email notifications) ---
SENDGRID_API_KEY=your_sendgrid_api_key_here
# Must be a verified sender in your SendGrid account
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Foto Coach
REPLY_TO_EMAIL=support@yourdomain.com

# --- OpenWeatherMap (required for weather-aware challenges) ---
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# --- User Configuration ---
USER_EMAIL=admin@yourdomain.com
