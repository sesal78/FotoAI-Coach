
# ============================================================
# Foto Photography Coach - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Appwrite (deploy Appwrite separately first) ---
# The public endpoint — same value used by both server and browser
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://appwrite.yourdomain.com/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=<your-project-id>

# Server-side only (never exposed to browser)
APPWRITE_ENDPOINT=https://appwrite.yourdomain.com/v1
APPWRITE_PROJECT_ID=<your-project-id>
# API key with: databases.read/write, storage.read/write, users.read/write
APPWRITE_API_KEY=<your-server-api-key>

# Created when you run: yarn ts-node scripts/appwrite-setup.ts
APPWRITE_DATABASE_ID=<your-database-id>
APPWRITE_STORAGE_BUCKET_ID=<your-storage-bucket-id>

# --- OpenAI API (required for challenge/itinerary generation and chat) ---
OPENAI_API_KEY=your_openai_api_key_here

# --- Cron job secret (required to call /api/scheduled/* endpoints) ---
# Generate with: openssl rand -hex 32
CRON_SECRET=your_cron_secret_here

# --- Email (SMTP primary, Resend fallback) ---
# At least one provider must be configured
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
# Optional fallback — used if SMTP fails
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Foto Coach
REPLY_TO_EMAIL=support@yourdomain.com

# --- OpenWeatherMap (required for weather-aware challenges) ---
# Weather: Open-Meteo, no API key needed (OPENWEATHERMAP_API_KEY is no longer used)

# --- User Configuration ---
USER_EMAIL=admin@yourdomain.com

# --- FotoAI refactor workspace (@fotoai/env, packages/*) ---
# Validated at boot by createServerEnv(); names only here, never real values.
FOTOAI_SUPABASE_URL=https://supabase.example.com
FOTOAI_SUPABASE_ANON_KEY=<anon-key>
FOTOAI_SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Optional: defaults to true when NODE_ENV=production, false otherwise
FOTOAI_COOKIE_SECURE=
# Optional: Google Places (New) server key; without it /api/v2/explore and /places answer 500 config
GOOGLE_MAPS_SERVER_API_KEY=
NODE_ENV=development
