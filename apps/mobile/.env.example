# Public app config (Expo inlines EXPO_PUBLIC_* into the APK; never put a secret here).
# Local runs read apps/mobile/.env; EAS builds read the FotoAI project's environment variables.
EXPO_PUBLIC_API_URL=https://myfoto.topues.com
EXPO_PUBLIC_SUPABASE_URL=https://supabase.techiesandbox.com
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Optional: crash reports (phase 3G)
EXPO_PUBLIC_SENTRY_DSN=
